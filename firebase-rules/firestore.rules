rules_version = '2';

// Firestore Database → Règles : coller ce texte puis « Publier »
service cloud.firestore {
  match /databases/{database}/documents {

    // Seul le compte enseignant peut modifier les données
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'mehdi.ghomari@outlook.fr';
    }

    match /{document=**} {
      allow read: if true;        // le site public lit les textes
      allow write: if isTeacher(); // ajout, modification, suppression
    }
  }
}
