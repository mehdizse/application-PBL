---
const isAdmin = Astro.url.pathname.startsWith('/admin');
---

<header class="site-header">
  <div class="inner">
    <a href="/" class="site-logo"><span class="mark">✍️</span>Le Mur des Textes</a>
    <nav class="site-nav">
      {isAdmin ? (
        <a href="/">Voir le site</a>
      ) : (
        <a href="/admin" class="hide-sm">Espace enseignant</a>
      )}
      <a href="/classe" class="accent">Mode Classe</a>
    </nav>
  </div>
</header>
