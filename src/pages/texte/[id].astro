---
import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
---

<BaseLayout pageTitle="Lire un texte · Le Mur des Textes">
  <div class="reader">
    <button onclick="history.length > 1 ? history.back() : (location.href = '/')" class="back">← Retour aux textes</button>
    <div id="texteContainer">
      <div class="skeleton" style="height:48px;width:60%;margin:22px 0 16px"></div>
      <div class="skeleton" style="height:320px"></div>
    </div>
  </div>
</BaseLayout>

<script>
  function escapeHtml(value) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function cleanupContent(content, groupeNom) {
    return String(content || '')
      .split('\n')
      .map((line) =>
        line
          .replace(/^Excellent travail.*!$/gm, '')
          .replace(/^Très bon travail.*!$/gm, '')
          .replace(new RegExp(`^${String(groupeNom || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}$`, 'gm'), '')
      )
      .join('\n')
      .trim();
  }

  async function waitForFirebase() {
    if (typeof window.getTexte === 'undefined') {
      await new Promise((resolve) => setTimeout(resolve, 80));
      return waitForFirebase();
    }
    return null;
  }

  document.addEventListener('DOMContentLoaded', async () => {
    await waitForFirebase();
    await loadTexte();
  });

  async function loadTexte() {
    const container = document.getElementById('texteContainer');

    try {
      const texteId = window.location.pathname.split('/').pop();

      if (!texteId || texteId === 'undefined') {
        container.innerHTML = `
          <div class="card state"><p style="font-weight:600;color:var(--ink)">Texte non trouvé</p></div>
        `;
        return;
      }

      const texte = await window.getTexte(texteId);
      if (!texte) {
        container.innerHTML = `
          <div class="card state"><p style="font-weight:600;color:var(--ink)">Texte non trouvé</p><p>Ce texte n'est pas encore disponible.</p></div>
        `;
        return;
      }

      const badgesMap = {
        '⭐': 'Texte de la semaine',
        '🏆': 'Meilleure introduction',
        '🔗': 'Bon usage des connecteurs',
        '✍️': 'Texte bien rédigé',
        '🤝': 'Bon travail de groupe'
      };

      const cleanedContent = cleanupContent(texte.contenu, texte.groupeNom);
      const remarque = String(texte.remarqueEnseignant || '').trim();

      const badges = Array.isArray(texte.badges) ? texte.badges : [];
      document.title = `${texte.titre || 'Texte'} · Le Mur des Textes`;
      container.innerHTML = `
        <header class="reader-head">
          <div class="reader-meta">
            <span class="chip">${escapeHtml(texte.groupeNom || 'Groupe')}</span>
            ${texte.type ? `<span>${escapeHtml(texte.type)}</span>` : ''}
          </div>
          <h1>${escapeHtml(texte.titre || 'Sans titre')}</h1>
          ${badges.length ? `
            <div class="badges">
              ${badges.map((b) => `<span class="badge">${escapeHtml(b)} ${escapeHtml(badgesMap[b] || '')}</span>`).join('')}
            </div>` : ''}
        </header>

        <article class="sheet"><div class="body">${escapeHtml(cleanedContent)}</div></article>

        ${remarque ? `
          <aside class="remark">
            <div class="h">💬 Remarque de l'enseignant</div>
            <p>${escapeHtml(remarque)}</p>
          </aside>` : ''}
      `;
    } catch (error) {
      console.error('Erreur lors du chargement du texte:', error);
      container.innerHTML = `
        <div class="card state"><p style="font-weight:600;color:var(--ink)">Petit problème technique...</p><p>Réessaie dans quelques instants.</p></div>
      `;
    }
  }
</script>
