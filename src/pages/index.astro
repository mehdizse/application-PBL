---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="Le Mur des Textes">
  <!-- Bandeau d'accueil -->
  <section class="hero">
    <div class="inner">
      <span class="hero-kicker" id="heroWeek">✦ Productions écrites</span>
      <h1>Le Mur des Textes</h1>
      <p class="lead">Les productions écrites des élèves de 1AM et 3AM. Chaque semaine, un groupe est mis à l'honneur.</p>
      <div class="hero-actions">
        <a href="/classe" class="btn-gold">🏆 Découvrir le gagnant</a>
        <a href="#textes" class="btn-ghost">Lire les textes ↓</a>
      </div>
      <div class="stats" id="stats" hidden>
        <div class="stat"><b id="statTextes">0</b><span>textes publiés</span></div>
        <div class="stat"><b id="statGroupes">0</b><span>groupes d'auteurs</span></div>
        <div class="stat"><b id="statBadges">0</b><span>badges obtenus</span></div>
      </div>
    </div>
  </section>

  <div class="page">
    <!-- Gagnant de la semaine -->
    <div id="winnerBox">
      <div class="skeleton lift" style="height:260px"></div>
    </div>

    <!-- Consignes de la semaine -->
    <div id="briefBox"></div>

    <!-- Textes par semaine -->
    <div class="sec-head" id="textes">
      <h2>Les textes de la classe</h2>
      <span id="textesCount"></span>
    </div>
    <div id="textesContainer">
      <div class="skeleton" style="height:64px;margin-bottom:12px"></div>
      <div class="skeleton" style="height:64px"></div>
    </div>
  </div>
</BaseLayout>

<script>
  const BADGES = {
    '⭐': 'Texte de la semaine',
    '🏆': 'Meilleure introduction',
    '🔗': 'Connecteurs bien utilisés',
    '✍️': 'Texte bien rédigé',
    '🤝': 'Bon travail de groupe'
  };

  const esc = (v) => String(v ?? '')
    .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;').replaceAll("'", '&#39;');

  function dateFr(iso, withYear = false) {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(iso || '').trim());
    if (!m) return String(iso || '');
    const d = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));
    return new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', ...(withYear ? { year: 'numeric' } : {}), timeZone: 'UTC' }).format(d);
  }

  const weekRange = (w) => w?.startDate ? `Du ${dateFr(w.startDate)} au ${dateFr(w.endDate, true)}` : '';

  function excerpt(text, max) {
    const flat = String(text || '').split('\n').map((l) => l.trim()).filter(Boolean).join(' ');
    return flat.length > max ? flat.slice(0, max).trimEnd() + '…' : flat;
  }

  const timeOf = (v) => {
    if (v && typeof v.toDate === 'function') return v.toDate().getTime();
    const t = new Date(v || 0).getTime();
    return Number.isNaN(t) ? 0 : t;
  };

  function waitForFirebase() {
    return new Promise((resolve) => {
      const check = () => (typeof window.getWeeklyExpressionsData === 'function' && typeof window.subscribeWinningTeam === 'function')
        ? resolve() : setTimeout(check, 80);
      check();
    });
  }

  // Raccourci Ctrl+Shift+A vers l'espace enseignant (conservé)
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.shiftKey && (e.key === 'a' || e.key === 'A')) window.location.href = '/admin';
  });

  let textesById = new Map();

  (async () => {
    await waitForFirebase();
    try {
      const [weekly, allTextes, allGroupes] = await Promise.all([
        window.getWeeklyExpressionsData(),
        window.getTextes(),
        window.getGroupes()
      ]);
      textesById = new Map(allTextes.map((t) => [t.id, t]));
      const groupesVisibles = new Set(allGroupes.filter((g) => g.visible).map((g) => g.nom));
      const textes = allTextes.filter((t) => t.visible && groupesVisibles.has(t.groupeNom));

      renderHero(weekly, textes);
      renderBrief(weekly?.currentWeek);
      renderWeeks(weekly, textes);
    } catch (error) {
      console.error('Erreur chargement accueil:', error);
      document.getElementById('textesContainer').innerHTML = '<div class="card state">Petit problème technique… Réessaie dans quelques instants.</div>';
    }
    listenWinner();
  })();

  function renderHero(weekly, textes) {
    const range = weekRange(weekly?.currentWeek);
    if (range) document.getElementById('heroWeek').textContent = `✦ Semaine ${range.charAt(0).toLowerCase()}${range.slice(1)}`;
    const badges = textes.reduce((n, t) => n + (Array.isArray(t.badges) ? t.badges.length : 0), 0);
    document.getElementById('statTextes').textContent = textes.length;
    document.getElementById('statGroupes').textContent = new Set(textes.map((t) => t.groupeNom)).size;
    document.getElementById('statBadges').textContent = badges;
    document.getElementById('stats').hidden = false;
  }

  function renderBrief(week) {
    const items = Array.isArray(week?.expressions) ? week.expressions.filter(Boolean) : [];
    if (!items.length) return;
    document.getElementById('briefBox').innerHTML = `
      <div class="sec-head"><h2>Consignes de la semaine</h2><span>${esc(weekRange(week))}</span></div>
      <div class="card brief">
        <ol>${items.map((e, i) => `<li><span class="n">${i + 1}</span><span>${esc(e)}</span></li>`).join('')}</ol>
      </div>`;
  }

  function textCard(t) {
    const icons = (Array.isArray(t.badges) ? t.badges : []).map((b) => `<span title="${esc(BADGES[b] || b)}">${esc(b)}</span>`).join('');
    return `
      <a class="card tcard" href="/texte/${encodeURIComponent(t.id)}">
        <div class="top"><span class="chip">${esc(t.groupeNom || 'Groupe')}</span><span class="icons">${icons}</span></div>
        <h3>${esc(t.titre || 'Sans titre')}</h3>
        ${t.type ? `<div class="type">${esc(t.type)}</div>` : ''}
        <p>${esc(excerpt(t.contenu, 180))}</p>
        <span class="link-arrow">Lire le texte →</span>
      </a>`;
  }


  // Semaine d'un texte : le choix manuel de l'enseignant compte en priorité ;
  // sinon, la semaine dont les dates contiennent le jour d'ajout du texte.
  function effectiveWeekId(texte, weeks) {
    const stored = String(texte?.weekId || '').trim();
    if (texte?.weekManual) return stored;
    const raw = texte?.createdAt;
    const d = raw && typeof raw.toDate === 'function' ? raw.toDate() : new Date(raw || 0);
    if (Number.isNaN(d.getTime()) || d.getTime() === 0) return stored;
    const pad = (n) => String(n).padStart(2, '0');
    const day = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const plus2 = (iso) => {
      const t = new Date(`${iso}T00:00:00Z`); t.setUTCDate(t.getUTCDate() + 2);
      return t.toISOString().slice(0, 10);
    };
    const inside = (w) => w?.startDate && w?.endDate && w.startDate <= day && day <= plus2(w.endDate);
    const own = (weeks || []).find((w) => w.weekId === stored);
    if (own && inside(own)) return stored;
    const match = (weeks || []).find(inside);
    return match ? match.weekId : stored;
  }

  function renderWeeks(weekly, textes) {
    const container = document.getElementById('textesContainer');
    const weeks = Array.isArray(weekly?.weeks) ? weekly.weeks : [];
    const currentId = String(weekly?.currentWeek?.weekId || '').trim();
    const fallbackId = currentId || (window.getIsoWeekInfo?.(new Date()).weekId ?? '');

    const byWeek = {};
    textes.forEach((t) => {
      const id = effectiveWeekId(t, weeks) || fallbackId;
      (byWeek[id] ||= []).push(t);
    });

    document.getElementById('textesCount').textContent = textes.length ? `${textes.length} texte${textes.length > 1 ? 's' : ''}` : '';

    // Semaine en cours toujours affichée ; anciennes semaines seulement si elles ont des textes
    const shown = weeks.filter((w) => w.weekId === currentId || (byWeek[w.weekId] || []).length);
    if (!shown.length) {
      container.innerHTML = '<div class="card state">Aucun texte publié pour le moment.</div>';
      return;
    }

    container.innerHTML = shown.map((w, i) => {
      const list = (byWeek[w.weekId] || []).sort((a, b) => timeOf(b.createdAt) - timeOf(a.createdAt));
      const isNow = w.weekId === currentId;
      return `
        <details class="week" ${i === 0 ? 'open' : ''}>
          <summary>
            <span class="t">${esc(weekRange(w) || w.weekId)}</span>
            <span class="c">
              ${isNow ? '<span class="pill-now">Cette semaine</span>' : ''}
              ${list.length} texte${list.length > 1 ? 's' : ''}
              <span class="chev">▾</span>
            </span>
          </summary>
          ${list.length ? `<div class="grid-texts">${list.map(textCard).join('')}</div>` : '<div class="empty">Pas encore de texte publié cette semaine.</div>'}
        </details>`;
    }).join('');
  }

  function listenWinner() {
    const box = document.getElementById('winnerBox');
    let lastKey = '';
    window.subscribeWinningTeam(async (w) => {
      try {
        const key = w?.solo === true ? 'a' : String(w?.winner || '');
        const team = key ? w?.teams?.[key] : null;
        if (!team) { box.innerHTML = ''; return; }

        const members = (Array.isArray(team.members) ? team.members : []).filter((m) => m?.prenom || m?.photoUrl).slice(0, 4);
        const renderKey = JSON.stringify([key, team.texteId, team.groupeId, members]);
        if (renderKey === lastKey) return;
        lastKey = renderKey;

        const texte = team.texteId ? (textesById.get(team.texteId) || await window.getTexte(team.texteId)) : null;
        const groupe = texte?.groupeNom || 'Groupe gagnant';
        const faces = members.map((m) => `
          <div class="face">
            <div class="ph initial">${esc(String(m.prenom || '').trim().charAt(0).toUpperCase() || '★')}</div>
            ${esc(m.prenom || '')}
          </div>`).join('');

        box.innerHTML = `
          <div class="card winner lift">
            <div class="winner-left">
              <span class="winner-badge">🏆 Groupe de la semaine</span>
              <div class="winner-group">${esc(groupe)}</div>
              <div class="faces">${faces}</div>
            </div>
            <div class="winner-right">
              ${texte ? `
                ${texte.type ? `<span class="type">${esc(texte.type)}</span>` : ''}
                <h3>${esc(texte.titre || 'Sans titre')}</h3>
                <p class="excerpt">${esc(excerpt(texte.contenu, 420))}</p>
                <a class="link-arrow" href="/texte/${encodeURIComponent(texte.id)}">Lire le texte en entier →</a>
              ` : `<h3>Bravo à toute l'équipe !</h3>`}
            </div>
          </div>`;
      } catch (error) {
        console.error('Erreur affichage gagnant:', error);
      }
    });
  }
</script>
