    const startDate = document.getElementById('weekStartInput').value;
    const endDate = document.getElementById('weekEndInput').value;
    const expressions = parseExpressionsInput(document.getElementById('defiInput').value);

    const fallback = getCurrentWeekFallback();

    try {
      validateWeeklyForm({
        weekId: weekId || fallback.weekId,
        startDate: startDate || fallback.startDate,
        endDate: endDate || fallback.endDate,
        expressions
      });

      await window.setWeeklyExpressionsForWeek({
        weekId: weekId || fallback.weekId,
        startDate: startDate || fallback.startDate,
        endDate: endDate || fallback.endDate,
        expressions
      });
      await reloadWeeklyExpressions();
    } catch (error) {
      alert('Erreur lors de la sauvegarde des expressions: ' + error.message);
    }
  }

  window.reparerMigrationLegacy = async function() {
    const status = document.getElementById('legacyRepairStatus');
    if (status) status.textContent = 'Reparation en cours...';

    try {
      if (typeof window.repairLegacyMigrationWeeks !== 'function') {
        throw new Error('Fonction de reparation indisponible');
      }

      const result = await window.repairLegacyMigrationWeeks();
      await reloadWeeklyExpressions();

      if (!status) return;
      if (result?.repaired) {
        status.textContent = `Migration legacy reparee (semaine: ${result.expectedWeekId}, mode: ${result.selectionMode}).`;
      } else {
        status.textContent = `Aucune correction appliquee (${result?.reason || 'inconnu'}).`;
      }
    } catch (error) {
      if (status) status.textContent = `Echec de reparation: ${error.message}`;
    }
  }

  window.loadBadges = function() {
    const badges = ['⭐', '🏆', '🔗', '✍️', '🤝'];
    const container = document.getElementById('badgesList');
    
    if (!textes.length) { container.innerHTML = '<div class="empty-state">Aucun texte à récompenser pour le moment.</div>'; return; }
    const timeOf = (v) => (v?.toDate?.() || new Date(v || 0)).getTime() || 0;
    container.innerHTML = [...textes].sort((a, b) => timeOf(b.createdAt) - timeOf(a.createdAt)).map(texte => `
      <div class="badge-row">
        <div class="main">
          <div style="font-weight:600">${esc(texte.titre || 'Sans titre')}</div>
          <div style="margin-top:4px"><span class="chip-g">${esc(texte.groupeNom || '')}</span></div>
        </div>
        <div class="badge-toggles">
          ${badges.map(badge => `
            <button onclick="toggleBadge('${texte.id}', '${badge}')" title="${esc(BADGE_LABELS[badge])}" class="${texte.badges?.includes(badge) ? 'on' : ''}">${badge}</button>
          `).join('')}
        </div>
      </div>
    `).join('');
  }

  window.toggleBadge = async function(texteId, badge) {
    const texte = textes.find(t => t.id === texteId);
    const badges = texte.badges || [];
    
    if (badges.includes(badge)) {
      badges.splice(badges.indexOf(badge), 1);
    } else {
      badges.push(badge);
    }
    
    try {
      await window.updateTexte(texteId, { badges });
      window.loadTextes();
      window.loadBadges();
    } catch (error) {
      alert('Erreur lors de la mise à jour des badges: ' + error.message);
    }
  }

  window.editTexte = function(id) {
    const texte = textes.find(t => t.id === id);
    if (!texte) return;

    // Créer le formulaire d'édition
    const editForm = `
      <div id="editForm-${id}" class="edit-box">
        <h4>Modifier le texte</h4>
        <div class="grid-2">
          <label class="field"><span>Titre</span>
            <input type="text" id="editTitle-${id}" value="${esc(texte.titre)}">
          </label>
          <label class="field"><span>Semaine</span>
            <select id="editWeek-${id}">${weekOptions(effectiveWeekId(texte, weeklyExpressionsData?.weeks))}</select>
          </label>
        </div>
        <label class="field"><span>Contenu</span>
          <textarea id="editContent-${id}" rows="8">${esc(texte.contenu)}</textarea>
        </label>
        <label class="field"><span>Remarque de l'enseignant (optionnel)</span>
          <textarea id="editRemarque-${id}" rows="3">${esc(texte.remarqueEnseignant || '')}</textarea>
        </label>
        <div class="row-actions end" style="margin-top:0">
          <button onclick="cancelEdit('${id}')" class="btn btn-ghost btn-sm">Annuler</button>
          <button onclick="saveTexte('${id}')" class="btn btn-primary btn-sm">Enregistrer</button>
        </div>
      </div>
    `;

    // Insérer le formulaire après la carte du texte
    const texteCard = document.querySelector(`[data-texte-id="${id}"]`);
    if (texteCard) {
      texteCard.insertAdjacentHTML('afterend', editForm);
      texteCard.style.display = 'none';
    }
  }

  window.saveTexte = async function(id) {
    const titre = document.getElementById(`editTitle-${id}`).value.trim();
    const contenu = document.getElementById(`editContent-${id}`).value.trim();
    const remarqueEnseignant = document.getElementById(`editRemarque-${id}`).value.trim();
    const weekId = document.getElementById(`editWeek-${id}`)?.value || '';
    const texte0 = textes.find((t) => t.id === id);
    
    if (!titre || !contenu) {
      alert('Le titre et le contenu ne peuvent pas être vides');
      return;
    }

    try {
      await window.updateTexte(id, { titre, contenu, remarqueEnseignant, ...(weekId && weekId !== effectiveWeekId(texte0, weeklyExpressionsData?.weeks) ? { weekId, weekManual: true } : {}) });
      window.loadTextes();
    } catch (error) {
      alert('Erreur lors de la sauvegarde: ' + error.message);
    }
  }

  window.cancelEdit = function(id) {
    const editForm = document.getElementById(`editForm-${id}`);
    const texteCard = document.querySelector(`[data-texte-id="${id}"]`);
    
    if (editForm) editForm.remove();
    if (texteCard) texteCard.style.display = '';
  }

  window.editGroupe = function(id) {
    const groupe = groupes.find(g => g.id === id);
    if (!groupe) return;

    // Créer le formulaire d'édition
    const editForm = `
      <div id="editGroupeForm-${id}" class="edit-box">
        <h4>Renommer le groupe</h4>
        <label class="field"><span>Nom du groupe</span>
          <input type="text" id="editGroupeName-${id}" value="${esc(groupe.nom)}">
        </label>
        <div class="row-actions end" style="margin-top:0">
          <button onclick="cancelGroupeEdit('${id}')" class="btn btn-ghost btn-sm">Annuler</button>
          <button onclick="saveGroupe('${id}')" class="btn btn-primary btn-sm">Enregistrer</button>
        </div>
      </div>
    `;

    // Insérer le formulaire après la carte du groupe
    const groupeCard = document.querySelector(`[data-groupe-id="${id}"]`);
    if (groupeCard) {
      groupeCard.insertAdjacentHTML('afterend', editForm);
      groupeCard.style.display = 'none';
    }
  }

  window.saveGroupe = async function(id) {
    const nom = document.getElementById(`editGroupeName-${id}`).value.trim();
    
    if (!nom) {
      alert('Le nom du groupe ne peut pas être vide');
      return;
    }

    try {
      // Récupérer l'ancien nom du groupe
      const groupe = groupes.find(g => g.id === id);
      const ancienNom = groupe.nom;
      
      // Mettre à jour le groupe
      await window.updateGroupe(id, { nom });
      
      // Si le nom a changé, mettre à jour tous les textes de ce groupe
      if (ancienNom !== nom) {
        const textesDuGroupe = textes.filter(texte => texte.groupeNom === ancienNom);
        
        // Mettre à jour tous les textes en parallèle
        await Promise.all(
          textesDuGroupe.map(texte => 
            window.updateTexte(texte.id, { groupeNom: nom })
          )
        );
      }
      
      window.loadGroupes();
      window.loadTextes();
    } catch (error) {
      alert('Erreur lors de la sauvegarde: ' + error.message);
    }
  }

  window.cancelGroupeEdit = function(id) {
    const editForm = document.getElementById(`editGroupeForm-${id}`);
    const groupeCard = document.querySelector(`[data-groupe-id="${id}"]`);
    
    if (editForm) editForm.remove();
    if (groupeCard) groupeCard.style.display = '';
  }
</script>

