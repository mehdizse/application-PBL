  // Liste des semaines pour les menus déroulants (la plus récente d'abord)
  function weekOptions(selected) {
    const weeks = Array.isArray(weeklyExpressionsData?.weeks) ? [...weeklyExpressionsData.weeks] : [];
    weeks.sort((a, b) => String(b.startDate || b.weekId).localeCompare(String(a.startDate || a.weekId)));
    if (selected && !weeks.some((w) => w.weekId === selected)) weeks.unshift({ weekId: selected });
    const current = weeklyExpressionsData?.currentWeek?.weekId;
    return weeks.map((w) => {
      const label = w.startDate ? `Du ${frDate(w.startDate)} au ${frDate(w.endDate)}` : `Semaine ${w.weekId}`;
      return `<option value="${esc(w.weekId)}" ${w.weekId === selected ? 'selected' : ''}>${label}${w.weekId === current ? ' (en cours)' : ''}</option>`;
    }).join('');
  }

