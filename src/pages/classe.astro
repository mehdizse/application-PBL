---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout bare pageTitle="Mode Classe · Mur des Textes">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Literata:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
  </Fragment>

  <div id="stage" class="stage">
    <canvas id="confetti" class="confetti" aria-hidden="true"></canvas>

    <!-- Barre du haut -->
    <div class="topbar">
      <div class="brand">📝 Le Mur des Textes</div>
      <div class="tools">
        <button id="soundBtn" class="tool" title="Son">🔊</button>
        <button id="fullBtn" class="tool" title="Plein écran (F)">⛶</button>
        <a href="/" class="tool" title="Quitter">✕</a>
      </div>
    </div>

    <!-- Zone des diapositives -->
    <div id="slide" class="slide">
      <div class="loading">
        <div class="spinner"></div>
        <p>Préparation de la séance…</p>
      </div>
    </div>

    <!-- Navigation -->
    <div class="navbar">
      <button id="prevBtn" class="navbtn" aria-label="Précédent">◀</button>
      <div id="dots" class="dots"></div>
      <button id="nextBtn" class="navbtn primary" aria-label="Suivant">▶</button>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .stage {
    --bg1: #1b1446;
    --bg2: #2b1d6b;
    --ink: #ffffff;
    --muted: #c9c2f5;
    --gold: #ffc93c;
    --gold-dark: #d99a00;
    --pink: #ff6b9a;
    --mint: #3ee6b0;
    --sky: #4cc3ff;
    --card: rgba(255, 255, 255, 0.08);
    --card-border: rgba(255, 255, 255, 0.16);
  }

  html, body { height: 100%; }
  body { background: var(--bg1); overflow: hidden; }
  body main { display: block; }

  .stage {
    position: fixed; inset: 0;
    display: flex; flex-direction: column;
    background:
      radial-gradient(1200px 600px at 10% -10%, rgba(255, 107, 154, 0.25), transparent 60%),
      radial-gradient(1000px 700px at 110% 110%, rgba(76, 195, 255, 0.22), transparent 60%),
      linear-gradient(160deg, var(--bg1), var(--bg2));
    color: var(--ink);
    font-family: 'Baloo 2', 'Inter', system-ui, sans-serif;
    user-select: none;
  }
  .stage h1, .stage h2, .stage h3 { color: var(--ink); font-family: 'Baloo 2', system-ui, sans-serif; }

  .confetti { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 50; }

  .topbar { display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; z-index: 10; }
  .brand { font-weight: 700; font-size: 18px; opacity: 0.85; }
  .tools { display: flex; gap: 8px; }
  .tool {
    width: 40px; height: 40px; border-radius: 12px; border: 1px solid var(--card-border);
    background: var(--card); color: var(--ink); font-size: 18px; display: grid; place-items: center;
    cursor: pointer; text-decoration: none;
  }
  .tool:hover { background: rgba(255, 255, 255, 0.16); }

  .slide {
    flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 8px 24px; text-align: center; overflow: hidden;
  }

  .fit { width: 100%; display: flex; flex-direction: column; align-items: center; transform-origin: center center; flex: none; }
  .expr-list.cols2 { grid-template-columns: 1fr 1fr; }
  .expr-list.cols2 .expr { font-size: clamp(18px, 2.1vw, 32px); }
  .navbar { display: flex; align-items: center; justify-content: center; gap: 16px; padding: 12px 16px 18px; z-index: 10; }
  .navbtn {
    width: 56px; height: 56px; border-radius: 50%; border: 1px solid var(--card-border);
    background: var(--card); color: var(--ink); font-size: 20px; cursor: pointer;
  }
  .navbtn.primary { background: var(--gold); color: #3a2600; border-color: var(--gold); box-shadow: 0 6px 0 var(--gold-dark); }
  .navbtn.primary:active { transform: translateY(3px); box-shadow: 0 3px 0 var(--gold-dark); }
  .navbtn:disabled { opacity: 0.3; cursor: default; }
  .dots { display: flex; gap: 8px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: rgba(255, 255, 255, 0.25); transition: all .3s; }
  .dot.on { background: var(--gold); width: 28px; border-radius: 6px; }

  .loading { opacity: 0.8; font-size: 22px; }
  .spinner {
    width: 48px; height: 48px; margin: 0 auto 16px; border-radius: 50%;
    border: 5px solid rgba(255, 255, 255, 0.2); border-top-color: var(--gold); animation: spin 1s linear infinite;
  }

  /* Éléments communs */
  .kicker {
    display: inline-block; padding: 6px 18px; border-radius: 999px; font-weight: 700; letter-spacing: .04em;
    background: rgba(255, 201, 60, 0.15); color: var(--gold); border: 1px solid rgba(255, 201, 60, 0.4);
    font-size: clamp(14px, 1.6vw, 20px); margin-bottom: 14px; text-transform: uppercase;
  }
  .big-title { font-size: clamp(40px, 7vw, 110px); line-height: 1; font-weight: 800; margin: 0 0 12px; }
  .sub { font-size: clamp(18px, 2.4vw, 32px); color: var(--muted); margin: 0; }
  .cta {
    margin-top: 36px; padding: 16px 40px; border-radius: 999px; border: none; cursor: pointer;
    background: var(--gold); color: #3a2600; font-family: inherit; font-weight: 800; font-size: clamp(20px, 2.4vw, 30px);
    box-shadow: 0 8px 0 var(--gold-dark); transition: transform .15s, box-shadow .15s, background-color .15s;
  }
  .cta:hover { background: #ffd666; transform: translateY(-2px); box-shadow: 0 10px 0 var(--gold-dark); }
  .cta:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  .cta:active { transform: translateY(4px); box-shadow: 0 4px 0 var(--gold-dark); }

  .pop { animation: pop .6s cubic-bezier(.2, 1.4, .4, 1) both; }
  .rise { animation: rise .6s ease-out both; }

  /* Intro */
  .intro-emoji { font-size: clamp(44px, 7vw, 96px); line-height: 1.1; margin-bottom: 8px; }

  /* Expressions */
  .expr-list { display: grid; gap: 14px; width: min(1100px, 100%); margin-top: 18px; }
  .expr {
    display: flex; align-items: center; gap: 18px; text-align: left; padding: 16px 24px; border-radius: 20px;
    background: var(--card); border: 1px solid var(--card-border);
    font-size: clamp(20px, 3vw, 42px); font-weight: 700; line-height: 1.2;
  }
  .expr .num {
    flex: none; width: 1.6em; height: 1.6em; border-radius: 50%; display: grid; place-items: center;
    background: var(--mint); color: #053b2c; font-size: .8em;
  }

  /* Classement */
  .board { width: min(1100px, 100%); display: grid; gap: 12px; margin-top: 18px; }
  .row {
    display: grid; grid-template-columns: 64px minmax(120px, 260px) 1fr minmax(90px, auto); align-items: center; gap: 16px;
    font-size: clamp(18px, 2.4vw, 32px); font-weight: 700;
  }
  .row .rank { font-size: 1.4em; text-align: center; }
  .row .name { text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row .track { height: 1.3em; border-radius: 999px; background: rgba(255, 255, 255, 0.08); overflow: hidden; }
  .row .bar { height: 100%; width: 0; border-radius: 999px; transition: width 1.4s cubic-bezier(.2, .8, .2, 1); }
  .row .pts { text-align: right; color: var(--gold); }
  .row .medals { font-size: .7em; text-align: left; opacity: .9; }
  .legend { margin-top: 20px; color: var(--muted); font-size: clamp(14px, 1.6vw, 20px); }

  /* Duel */
  .duel { display: flex; align-items: center; justify-content: center; gap: clamp(16px, 4vw, 60px); margin-top: 20px; width: 100%; }
  .team {
    flex: 1; max-width: 460px; padding: 22px; border-radius: 28px; background: var(--card); border: 2px solid var(--card-border);
    transition: transform .8s cubic-bezier(.2, 1.4, .4, 1), opacity .6s, filter .6s, border-color .6s, box-shadow .6s;
  }
  .team h3 { font-size: clamp(22px, 3vw, 40px); margin: 10px 0 0; }
  .faces { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
  .face {
    width: clamp(64px, 9vw, 120px); height: clamp(64px, 9vw, 120px); border-radius: 50%; overflow: hidden;
    background: rgba(255, 255, 255, 0.12); border: 4px solid rgba(255, 255, 255, 0.3); display: grid; place-items: center; font-size: 36px;
  }
  .face img { width: 100%; height: 100%; object-fit: cover; }
  .prenoms { margin-top: 8px; color: var(--muted); font-size: clamp(16px, 2vw, 24px); }
  .vs { font-size: clamp(40px, 7vw, 100px); font-weight: 800; color: var(--pink); text-shadow: 0 0 30px rgba(255, 107, 154, .6); }
  .team.win { transform: scale(1.12); border-color: var(--gold); box-shadow: 0 0 60px rgba(255, 201, 60, .55); }
  .team.win .face { border-color: var(--gold); }
  .team.lose { opacity: .35; filter: grayscale(1); transform: scale(.9); }
  .crown { font-size: 54px; height: 60px; }
  .solo-zone { margin-top: 16px; min-height: clamp(200px, 32vh, 360px); display: grid; place-items: center; }
  .mystery {
    width: clamp(160px, 22vw, 280px); height: clamp(160px, 22vw, 280px); border-radius: 50%;
    display: grid; place-items: center; font-size: clamp(90px, 14vw, 180px); font-weight: 800; color: var(--gold);
    background: var(--card); border: 4px dashed rgba(255, 201, 60, .6);
  }
  .mystery .countdown { font-size: inherit; }
  .solo-faces { display: flex; justify-content: center; gap: clamp(14px, 3vw, 40px); flex-wrap: wrap; }
  .solo-person { animation: pop .7s cubic-bezier(.2, 1.4, .4, 1) both; animation-delay: calc(var(--i) * .25s); }
  .face.big {
    width: clamp(100px, 14vw, 190px); height: clamp(100px, 14vw, 190px); border-color: var(--gold);
    box-shadow: 0 0 40px rgba(255, 201, 60, .45); font-size: 56px;
  }
  .solo-name { margin-top: 10px; font-size: clamp(22px, 3vw, 40px); font-weight: 800; }
  .countdown { font-size: clamp(120px, 22vw, 300px); font-weight: 800; color: var(--gold); line-height: 1; animation: beat .9s ease-out both; }

  /* Texte gagnant */
  .paper {
    width: min(1000px, 100%); max-height: 100%; overflow: auto; text-align: left; padding: clamp(20px, 4vw, 48px);
    background: #fffaf0; color: #2a2238; border-radius: 24px; box-shadow: 0 20px 60px rgba(0, 0, 0, .35);
    font-family: 'Literata', Georgia, serif; user-select: text;
  }
  .paper h2 { font-family: 'Baloo 2', sans-serif; color: #2a2238; font-size: clamp(26px, 3.6vw, 48px); line-height: 1.1; margin: 0 0 4px; }
  .paper .meta { font-family: 'Baloo 2', sans-serif; color: #7a6f94; font-size: clamp(14px, 1.6vw, 20px); margin-bottom: 18px; }
  .paper p { font-size: clamp(18px, 2.2vw, 30px); line-height: 1.6; margin: 0 0 .7em; }
  .paper mark { background: linear-gradient(transparent 45%, #ffe06b 45%); color: inherit; padding: 0 .1em; }
  .hint { margin-top: 10px; color: var(--muted); font-size: clamp(13px, 1.4vw, 18px); }

  /* Fin */
  .stars { font-size: clamp(40px, 6vw, 80px); letter-spacing: .2em; margin-bottom: 10px; }
  .defi {
    margin-top: 28px; padding: 18px 28px; border-radius: 22px; border: 2px dashed var(--mint);
    font-size: clamp(18px, 2.4vw, 32px); max-width: 900px;
  }

  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes pop { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: scale(1); } }
  @keyframes rise { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
  @keyframes float { 50% { transform: translateY(-14px) rotate(-4deg); } }
  @keyframes pulse { 50% { transform: scale(1.05); } }
  @keyframes beat { from { opacity: 0; transform: scale(2.2); } 40% { opacity: 1; transform: scale(1); } to { opacity: .2; transform: scale(.85); } }

  @media (max-width: 900px) {
    .expr-list.cols2 { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .row { grid-template-columns: 40px 1fr 60px; }
    .row .track { grid-column: 1 / -1; order: 4; }
    .duel { flex-direction: column; gap: 10px; }
    .vs { font-size: 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
  }
</style>

<script>
  // ===== Réglages =====
  const POINTS_PAR_TEXTE = 10;
  const POINTS_BADGE = { '⭐': 30, '🏆': 15, '🔗': 15, '✍️': 15, '🤝': 15 };
  const BAR_COLORS = ['#ffc93c', '#3ee6b0', '#4cc3ff', '#ff6b9a', '#b18cff', '#ff9f43'];

  const slideEl = document.getElementById('slide');
  const dotsEl = document.getElementById('dots');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');

  let slides = [];
  let index = 0;
  let data = null;
  let duelState = 'versus'; // versus | counting | revealed
  let soundOn = true;

  // ===== Utilitaires =====
  const esc = (v) => String(v ?? '')
    .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;').replaceAll("'", '&#39;');

  const wait = (ms) => new Promise((r) => setTimeout(r, ms));

  function formatDateFr(iso) {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(iso || '').trim());
    if (!m) return '';
    const d = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));
    return new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(d);
  }

  function waitForFirebase() {
    return new Promise((resolve) => {
      const check = () => (typeof window.getWinningTeam === 'function' && typeof window.getWeeklyExpressionsData === 'function')
        ? resolve() : setTimeout(check, 80);
      check();
    });
  }

  // ===== Son (généré, aucun fichier) =====
  let audio = null;
  function ac() {
    if (!soundOn) return null;
    if (!audio) {
      const Ctx = window.AudioContext || window.webkitAudioContext;
      if (!Ctx) return null;
      audio = new Ctx();
    }
    if (audio.state === 'suspended') audio.resume();
    return audio;
  }

  function noiseBuffer(ctx, seconds) {
    const buf = ctx.createBuffer(1, ctx.sampleRate * seconds, ctx.sampleRate);
    const ch = buf.getChannelData(0);
    for (let i = 0; i < ch.length; i++) ch[i] = Math.random() * 2 - 1;
    return buf;
  }

  function hit(ctx, t, gain, freq = 1800, dur = 0.06) {
    const src = ctx.createBufferSource();
    src.buffer = noiseBuffer(ctx, dur);
    const f = ctx.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = freq;
    const g = ctx.createGain();
    g.gain.setValueAtTime(gain, t); g.gain.exponentialRampToValueAtTime(0.001, t + dur);
    src.connect(f).connect(g).connect(ctx.destination); src.start(t);
  }

  function playDrumroll(seconds) {
    const ctx = ac(); if (!ctx) return;
    const t0 = ctx.currentTime;
    for (let t = 0; t < seconds; t += 0.045) hit(ctx, t0 + t, 0.15 + 0.5 * (t / seconds));
  }

  function playTick() {
    const ctx = ac(); if (!ctx) return;
    hit(ctx, ctx.currentTime, 0.8, 300, 0.25);
  }

  function playFanfare() {
    const ctx = ac(); if (!ctx) return;
    const t0 = ctx.currentTime;
    const notes = [[523.25, 0], [659.25, .14], [783.99, .28], [1046.5, .42], [783.99, .62], [1046.5, .76]];
    notes.forEach(([freq, at], i) => {
      const o = ctx.createOscillator(); o.type = 'triangle'; o.frequency.value = freq;
      const g = ctx.createGain(); const len = i === notes.length - 1 ? 1.2 : .18;
      g.gain.setValueAtTime(0, t0 + at); g.gain.linearRampToValueAtTime(.25, t0 + at + .02);
      g.gain.exponentialRampToValueAtTime(.001, t0 + at + len);
      o.connect(g).connect(ctx.destination); o.start(t0 + at); o.stop(t0 + at + len + .05);
    });
    // Applaudissements
    for (let t = 1; t < 3.5; t += 0.03) hit(ctx, t0 + t + Math.random() * .02, .25 * Math.random() * (1 - (t - 1) / 2.6), 2500 + Math.random() * 1500, .04);
  }

  function playWhoosh() {
    const ctx = ac(); if (!ctx) return;
    const t = ctx.currentTime;
    const o = ctx.createOscillator(); o.type = 'sine';
    o.frequency.setValueAtTime(400, t); o.frequency.exponentialRampToValueAtTime(900, t + .15);
    const g = ctx.createGain(); g.gain.setValueAtTime(.08, t); g.gain.exponentialRampToValueAtTime(.001, t + .2);
    o.connect(g).connect(ctx.destination); o.start(t); o.stop(t + .25);
  }

  // ===== Confettis =====
  const canvas = document.getElementById('confetti');
  const c2d = canvas.getContext('2d');
  let parts = [];
  let raf = null;

  function confetti(amount = 220) {
    canvas.width = innerWidth * devicePixelRatio; canvas.height = innerHeight * devicePixelRatio;
    const colors = ['#ffc93c', '#ff6b9a', '#3ee6b0', '#4cc3ff', '#ffffff', '#b18cff'];
    for (let i = 0; i < amount; i++) {
      const fromLeft = i % 2 === 0;
      parts.push({
        x: (fromLeft ? 0 : innerWidth) * devicePixelRatio,
        y: innerHeight * 0.7 * devicePixelRatio,
        vx: (fromLeft ? 1 : -1) * (6 + Math.random() * 12) * devicePixelRatio,
        vy: -(10 + Math.random() * 16) * devicePixelRatio,
        s: (6 + Math.random() * 8) * devicePixelRatio,
        r: Math.random() * Math.PI, vr: (Math.random() - .5) * .4,
        c: colors[i % colors.length], life: 0
      });
    }
    if (!raf) loop();
  }

  function loop() {
    c2d.clearRect(0, 0, canvas.width, canvas.height);
    parts.forEach((p) => {
      p.vy += 0.35 * devicePixelRatio; p.vx *= 0.985; p.x += p.vx; p.y += p.vy; p.r += p.vr; p.life++;
      c2d.save(); c2d.translate(p.x, p.y); c2d.rotate(p.r); c2d.fillStyle = p.c;
      c2d.fillRect(-p.s / 2, -p.s / 4, p.s, p.s / 2); c2d.restore();
    });
    parts = parts.filter((p) => p.y < canvas.height + 50 && p.life < 400);
    raf = parts.length ? requestAnimationFrame(loop) : null;
    if (!raf) c2d.clearRect(0, 0, canvas.width, canvas.height);
  }

  // ===== Données =====
  async function loadData() {
    await waitForFirebase();
    const [weekly, textes, groupes, winning] = await Promise.all([
      window.getWeeklyExpressionsData().catch(() => null),
      window.getTextes().catch(() => []),
      window.getGroupes().catch(() => []),
      window.getWinningTeam().catch(() => null)
    ]);

    const groupesVisibles = groupes.filter((g) => g.visible !== false);
    const nomsVisibles = new Set(groupesVisibles.map((g) => g.nom));
    const textesVisibles = textes.filter((t) => t.visible !== false && nomsVisibles.has(t.groupeNom));

    // Points par groupe
    const scores = groupesVisibles.map((g) => {
      const siens = textesVisibles.filter((t) => t.groupeNom === g.nom);
      const badges = siens.flatMap((t) => Array.isArray(t.badges) ? t.badges : []);
      const points = siens.length * POINTS_PAR_TEXTE + badges.reduce((s, b) => s + (POINTS_BADGE[b] || 10), 0);
      return { nom: g.nom, points, nbTextes: siens.length, badges };
    }).sort((a, b) => b.points - a.points || a.nom.localeCompare(b.nom));

    // Duel de la semaine
    let duel = null;
    if (winning?.teams && (winning.winner || winning.solo === true)) {
      const groupeNom = (id) => groupes.find((g) => g.id === id)?.nom || '';
      const team = (key) => {
        const t = winning.teams[key] || {};
        const members = (Array.isArray(t.members) ? t.members : []).filter((m) => m?.prenom || m?.photoUrl);
        return { key, nom: groupeNom(t.groupeId) || (key === 'a' ? 'Équipe A' : 'Équipe B'), members, texteId: t.texteId || '' };
      };
      const a = team('a'); const b = team('b');
      const solo = winning.solo === true;
      const winner = solo ? a : (winning.winner === 'b' ? b : a);
      const texte = winner.texteId ? textes.find((t) => t.id === winner.texteId) || null : null;
      duel = { a, b, solo, winnerKey: winner.key, texte };
    }

    const current = weekly?.currentWeek || null;
    return { current, scores, duel };
  }

  // ===== Diapositives =====
  function buildSlides() {
    const s = ['intro'];
    if (data.current?.expressions?.length) s.push('expressions');
    if (data.scores.length && !data.duel?.solo) s.push('classement');
    if (data.duel) s.push('duel');
    if (data.duel?.texte) s.push('texte');
    s.push('fin');
    return s;
  }

  function weekLabel() {
    const c = data.current;
    if (!c?.startDate) return 'Cette semaine';
    return `Semaine du ${formatDateFr(c.startDate)} au ${formatDateFr(c.endDate)}`;
  }

  function renderIntro() {
    return `
      <div class="intro-emoji">✍️</div>
      <div class="kicker pop">${esc(weekLabel())}</div>
      <h1 class="big-title rise">Le Mur des Textes</h1>
      <p class="sub rise" style="animation-delay:.15s">Qui a écrit le meilleur texte cette semaine ?</p>
      <button class="cta" data-action="next">C'est parti ! ▶</button>
    `;
  }

  function renderExpressions() {
    const items = data.current.expressions.map((e, i) => `
      <div class="expr rise" style="animation-delay:${0.2 + i * 0.25}s">
        <span class="num">${i + 1}</span><span>${esc(e)}</span>
      </div>`).join('');
    const cols = data.current.expressions.length > 4 ? 'cols2' : '';
    return `
      <div class="kicker pop">📚 À utiliser dans vos textes</div>
      <h2 class="big-title" style="font-size:clamp(34px,5vw,72px)">Les consignes de la semaine</h2>
      <div class="expr-list ${cols}">${items}</div>
    `;
  }

  function renderClassement() {
    const max = Math.max(1, ...data.scores.map((s) => s.points));
    const medal = (i) => ['🥇', '🥈', '🥉'][i] || `${i + 1}`;
    const rows = data.scores.map((s, i) => {
      const medals = s.badges.filter((b) => POINTS_BADGE[b]).join(' ');
      return `
      <div class="row rise" style="animation-delay:${(data.scores.length - i) * 0.18}s">
        <div class="rank">${medal(i)}</div>
        <div class="name">${esc(s.nom)}<div class="medals">${medals || '&nbsp;'}</div></div>
        <div class="track"><div class="bar" data-w="${Math.round((s.points / max) * 100)}" style="background:${BAR_COLORS[i % BAR_COLORS.length]}"></div></div>
        <div class="pts" data-count="${s.points}">0</div>
      </div>`;
    }).join('');
    return `
      <div class="kicker pop">🏁 Le championnat</div>
      <h2 class="big-title" style="font-size:clamp(34px,5vw,72px)">Classement des équipes</h2>
      <div class="board">${rows}</div>
      <p class="legend">Texte publié = ${POINTS_PAR_TEXTE} pts · ⭐ Texte de la semaine = 30 pts · 🏆 🔗 ✍️ 🤝 = 15 pts</p>
    `;
  }

  function teamCard(team) {
    const faces = team.members.length
      ? team.members.map((m) => `<div class="face">${m.photoUrl ? `<img src="${esc(m.photoUrl)}" alt="${esc(m.prenom)}">` : '👤'}</div>`).join('')
      : '<div class="face">👥</div>';
    const prenoms = team.members.map((m) => esc(m.prenom)).filter(Boolean).join(' · ');
    return `
      <div class="team" id="team-${team.key}">
        <div class="crown"></div>
        <div class="faces">${faces}</div>
        <h3>${esc(team.nom)}</h3>
        <div class="prenoms">${prenoms || '&nbsp;'}</div>
      </div>`;
  }

  function renderDuel() {
    duelState = 'versus';
    if (data.duel.solo) return renderSolo();
    const { a, b } = data.duel;
    return `
      <div class="kicker pop">⚔️ Le duel de la semaine</div>
      <h2 class="big-title" style="font-size:clamp(34px,5vw,72px)" id="duelTitle">Qui va gagner ?</h2>
      <div class="duel" id="duelZone">
        ${teamCard(a)}
        <div class="vs pop" id="vs">VS</div>
        ${teamCard(b)}
      </div>
      <button class="cta" data-action="reveal" id="revealBtn">Révéler le gagnant</button>
    `;
  }

  function renderSolo() {
    const t = data.duel.a;
    const faces = (t.members.length ? t.members : [{}]).map((m, i) => `
      <div class="solo-person" style="--i:${i}">
        <div class="face big">${m.photoUrl ? `<img src="${esc(m.photoUrl)}" alt="${esc(m.prenom)}">` : '👤'}</div>
        <div class="solo-name">${esc(m.prenom || '')}</div>
      </div>`).join('');
    return `
      <div class="kicker pop">🏆 Le groupe gagnant de la semaine</div>
      <h2 class="big-title" style="font-size:clamp(34px,5vw,72px)" id="duelTitle">Qui a gagné cette semaine ?</h2>
      <div id="soloZone" class="solo-zone">
        <div class="mystery" id="mystery">?</div>
        <div class="solo-reveal" id="soloReveal" hidden>
          <div class="crown">👑</div>
          <div class="solo-faces">${faces}</div>
        </div>
      </div>
      <button class="cta" data-action="reveal" id="revealBtn">Révéler le gagnant</button>
    `;
  }

  async function revealSolo() {
    duelState = 'counting';
    document.getElementById('revealBtn')?.remove();
    const mystery = document.getElementById('mystery');
    playDrumroll(3);
    for (const n of [3, 2, 1]) {
      mystery.innerHTML = `<div class="countdown">${n}</div>`;
      playTick();
      await wait(1000);
    }
    mystery.remove();
    document.getElementById('soloReveal').hidden = false;
    fitSlide();
    const title = document.getElementById('duelTitle');
    title.innerHTML = `Bravo <span style="color:var(--gold)">${esc(data.duel.a.nom)}</span> !`;
    title.classList.add('pop');
    playFanfare();
    confetti(260);
    setTimeout(() => confetti(160), 900);
    duelState = 'revealed';
  }

  function highlightExpressions(html) {
    const exprs = (data.current?.expressions || [])
      .map((e) => String(e).trim().replace(/[.!?…]+$/, ''))
      .filter((e) => e.length >= 3)
      .sort((x, y) => y.length - x.length);
    let out = html;
    exprs.forEach((e) => {
      const pattern = esc(e).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      out = out.replace(new RegExp(`(${pattern})`, 'gi'), '<mark>$1</mark>');
    });
    return out;
  }

  function renderTexte() {
    const t = data.duel.texte;
    const paragraphs = String(t.contenu || '').split(/\n+/).map((l) => l.trim()).filter(Boolean)
      .map((p) => `<p>${highlightExpressions(esc(p))}</p>`).join('');
    const team = data.duel.winnerKey === 'b' ? data.duel.b : data.duel.a;
    const hasMarks = paragraphs.includes('<mark>');
    return `
      <div class="paper rise">
        <h2>${esc(t.titre || 'Sans titre')}</h2>
        <div class="meta">🏆 ${esc(team.nom)}${t.type ? ' · ' + esc(t.type) : ''}</div>
        ${paragraphs}
      </div>
      ${hasMarks ? '<p class="hint">Les expressions de la semaine sont surlignées en jaune ✨</p>' : ''}
    `;
  }

  function renderFin() {
    return `
      <div class="stars pop">⭐⭐⭐</div>
      <h2 class="big-title rise">Bravo à toute la classe !</h2>
      <p class="sub rise" style="animation-delay:.15s">La semaine prochaine, c'est peut-être <b style="color:var(--gold)">votre</b> texte au tableau.</p>
      <div class="defi rise" style="animation-delay:.3s">🎯 Pour gagner des points : publiez un texte, utilisez les expressions de la semaine, soignez votre introduction et vos connecteurs.</div>
    `;
  }

  const renderers = { intro: renderIntro, expressions: renderExpressions, classement: renderClassement, duel: renderDuel, texte: renderTexte, fin: renderFin };

  function show(i) {
    index = Math.max(0, Math.min(slides.length - 1, i));
    const name = slides[index];
    const html = renderers[name]();
    // Le texte gagnant défile ; les autres écrans sont réduits pour tenir dans l'écran
    slideEl.innerHTML = name === 'texte' ? html : `<div class="fit">${html}</div>`;
    fitSlide();
    dotsEl.innerHTML = slides.map((_, k) => `<span class="dot ${k === index ? 'on' : ''}"></span>`).join('');
    prevBtn.disabled = index === 0;
    nextBtn.disabled = index === slides.length - 1;
    playWhoosh();
    if (name === 'classement') animateBoard();
    if (name === 'fin') setTimeout(() => confetti(160), 300);
  }

  function fitSlide() {
    const fit = slideEl.querySelector('.fit');
    if (!fit) return;
    fit.style.transform = 'none';
    const cs = getComputedStyle(slideEl);
    const availH = slideEl.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
    const availW = slideEl.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    const scale = Math.min(1, availH / fit.scrollHeight, availW / fit.scrollWidth);
    fit.style.transform = scale < 1 ? `scale(${scale})` : 'none';
  }
  window.addEventListener('resize', fitSlide);
  document.addEventListener('fullscreenchange', () => setTimeout(fitSlide, 100));
  document.fonts?.ready.then(fitSlide);

  function animateBoard() {
    const rows = [...slideEl.querySelectorAll('.row')];
    const n = rows.length;
    rows.forEach((row, i) => {
      const delay = (n - i) * 180 + 300;
      setTimeout(() => {
        row.querySelector('.bar').style.width = row.querySelector('.bar').dataset.w + '%';
        const ptsEl = row.querySelector('.pts');
        const target = +ptsEl.dataset.count; const start = performance.now();
        const step = (now) => {
          const k = Math.min(1, (now - start) / 1400);
          ptsEl.textContent = Math.round(target * (1 - Math.pow(1 - k, 3)));
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
        if (i === 0) setTimeout(() => { playFanfare(); confetti(120); }, 1300);
      }, delay);
    });
  }

  async function reveal() {
    if (duelState !== 'versus') return;
    if (data.duel.solo) return revealSolo();
    duelState = 'counting';
    document.getElementById('revealBtn')?.remove();
    const title = document.getElementById('duelTitle');
    const zone = document.getElementById('duelZone');
    const vs = document.getElementById('vs');
    playDrumroll(3);
    for (const n of [3, 2, 1]) {
      vs.outerHTML = `<div class="vs" id="vs"><div class="countdown">${n}</div></div>`;
      playTick();
      await wait(1000);
    }
    const winKey = data.duel.winnerKey;
    const loseKey = winKey === 'a' ? 'b' : 'a';
    document.getElementById('vs').innerHTML = '🏆';
    const win = document.getElementById(`team-${winKey}`);
    win.classList.add('win');
    win.querySelector('.crown').textContent = '👑';
    document.getElementById(`team-${loseKey}`).classList.add('lose');
    const nom = winKey === 'a' ? data.duel.a.nom : data.duel.b.nom;
    title.innerHTML = `Bravo <span style="color:var(--gold)">${esc(nom)}</span> !`;
    title.classList.add('pop');
    fitSlide();
    playFanfare();
    confetti(260);
    setTimeout(() => confetti(160), 900);
    duelState = 'revealed';
  }

  function next() {
    if (slides[index] === 'duel' && duelState === 'versus') return reveal();
    if (duelState === 'counting') return;
    if (index < slides.length - 1) show(index + 1);
  }
  function prev() {
    if (duelState === 'counting') return;
    if (index > 0) show(index - 1);
  }

  // ===== Commandes =====
  nextBtn.addEventListener('click', next);
  prevBtn.addEventListener('click', prev);
  slideEl.addEventListener('click', (e) => {
    const action = e.target.closest('[data-action]')?.dataset.action;
    if (action === 'next') next();
    if (action === 'reveal') reveal();
  });

  document.addEventListener('keydown', (e) => {
    // Flèches, espace et les touches des télécommandes de présentation
    if (['ArrowRight', ' ', 'PageDown', 'Enter'].includes(e.key)) { e.preventDefault(); next(); }
    if (['ArrowLeft', 'PageUp', 'Backspace'].includes(e.key)) { e.preventDefault(); prev(); }
    if (e.key === 'f' || e.key === 'F') toggleFull();
  });

  // Glisser sur téléphone / tablette
  let touchX = null;
  document.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
  document.addEventListener('touchend', (e) => {
    if (touchX === null) return;
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 60) (dx < 0 ? next : prev)();
    touchX = null;
  });

  function toggleFull() {
    if (!document.fullscreenElement) document.documentElement.requestFullscreen?.().catch(() => {});
    else document.exitFullscreen?.();
  }
  document.getElementById('fullBtn').addEventListener('click', toggleFull);
  const soundBtn = document.getElementById('soundBtn');
  soundBtn.addEventListener('click', () => {
    soundOn = !soundOn;
    soundBtn.textContent = soundOn ? '🔊' : '🔇';
  });

  // ===== Démarrage =====
  (async () => {
    try {
      data = await loadData();
      slides = buildSlides();
      show(0);
    } catch (err) {
      console.error('Mode classe :', err);
      slideEl.innerHTML = '<div class="loading">😅 Impossible de charger les données. Vérifie la connexion puis recharge la page.</div>';
    }
  })();
</script>
